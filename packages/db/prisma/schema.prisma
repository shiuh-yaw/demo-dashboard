// Prisma schema for @dynamic-demos/db. Consumed only by apps/dashboard (D-015).
//
// DATABASE_URL = Supabase pooler (6543, runtime). DIRECT_URL = direct (5432,
// migrations). `prisma db push` is forbidden in production - only
// `prisma migrate deploy`.

generator client {
  provider      = "prisma-client-js"
  // rhel target required: without it Vercel functions fail at runtime with
  // "Prisma Client could not locate the Query Engine".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProspectStatus {
  ACTIVE
  ARCHIVED
}

/// Team-owned workspace. Seeded default has slug "gtm".
model Team {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  createdAt   DateTime         @default(now())
  memberships TeamMembership[]
  prospects   Prospect[]
}

/// User membership in a Team. No per-membership role (workspace Role governs).
model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
  @@index([teamId])
}

/// 1:1 visual palette for a Prospect. Identity fields stay on Prospect.
model ProspectTheme {
  id                 String   @id @default(cuid())
  prospectId         String   @unique
  borderRadius       String?
  primaryColor       String
  primaryHoverColor  String?
  secondaryColor     String?
  accentColor        String?
  pageBackground     String?
  background         String?
  foreground         String?
  mutedTextColor     String?
  borderColor        String?
  rowBackground      String?
  rowHoverBackground String?
  gradientFrom       String?
  gradientTo         String?
  prospect           Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
}

/// A company we sell to. Owns identity + theme; demo configs reference it.
model Prospect {
  id                 String         @id @default(cuid())
  ownerId            String
  /// DB default is a deploy-window crutch for pre-teamId clients; dropped at contract.
  teamId             String         @default("team_gtm_default")
  createdById        String?
  status             ProspectStatus @default(ACTIVE)
  name               String
  description        String?
  companyUrl         String?
  /// "custom" | "dynamic" - decides whether `logoUrl` renders. Validated at the service layer.
  logo               String         @default("dynamic")
  logoUrl            String?
  /// Palette copied to ProspectTheme in GTM-03.5A; still canonical until the 03.5B cutover.
  borderRadius       String?
  primaryColor       String
  primaryHoverColor  String?
  secondaryColor     String?
  accentColor        String?
  pageBackground     String?
  background         String?
  foreground         String?
  mutedTextColor     String?
  borderColor        String?
  rowBackground      String?
  rowHoverBackground String?
  gradientFrom       String?
  gradientTo         String?
  /// @deprecated Dropped in the contract migration; query DemoConfig.prospectId instead.
  demoEarnId         String?
  demoCheckoutsId    String?
  demoWalletId       String?
  demoRemittanceId   String?
  domain             String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  demoConfigs        DemoConfig[]
  team               Team           @relation(fields: [teamId], references: [id])
  createdBy          User?          @relation("ProspectCreatedBy", fields: [createdById], references: [id])
  theme              ProspectTheme?

  @@index([ownerId])
  @@index([teamId])
  @@index([createdById])
}

/// Canonical transaction record (D-010). State changes only via
/// `assertValidTransition` at the service boundary - never widen at the DB.
model Transaction {
  id                  String         @id @default(cuid())
  kind                String
  state               String
  demoInstanceId      String?
  /// String, not a relation - nullable for pre-Phase-2 rows; decoupled lifetimes.
  prospectId          String?
  /// Self-relation for multi-leg flows; null for top-level transactions.
  parentTransactionId String?
  parent              Transaction?   @relation("TransactionParentChild", fields: [parentTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children            Transaction[]  @relation("TransactionParentChild")
  payload             Json
  refs                Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  webhookEvents       WebhookEvent[]

  @@index([demoInstanceId])
  @@index([prospectId])
  @@index([state])
  @@index([parentTransactionId])
}

/// Webhook audit row (D-011). `(provider, providerEventId)` is the dedup
/// primitive. `signatureValid = false` rows are kept on purpose - invalid
/// signatures are an attack signal worth auditing.
model WebhookEvent {
  id                String       @id @default(cuid())
  provider          String
  providerEventId   String
  eventType         String
  occurredAt        DateTime
  receivedAt        DateTime     @default(now())
  signatureValid    Boolean
  /// Untouched provider payload - source of truth for replay.
  rawPayload        Json
  normalizedPayload Json
  transactionId     String?
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  demoInstanceId    String?
  prospectId        String?
  /// "pending" | "processed" | "failed" | "ignored". Service layer enforces.
  processingStatus  String       @default("pending")
  processingError   String?
  processedAt       DateTime?

  @@unique([provider, providerEventId])
  @@index([transactionId])
  @@index([receivedAt])
  @@index([processingStatus])
}

/// Per-instance config for every demo type; `kind` discriminates. Plain TEXT
/// (no enum) on purpose: new demo types must not require a migration. Kinds
/// validated by the Zod union in demo-config-schemas.ts.
model DemoConfig {
  id             String    @id @default(cuid())
  kind           String
  ownerId        String
  createdById    String?
  name           String?
  description    String?
  prospectId     String?
  prospect       Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy      User?     @relation("DemoConfigCreatedBy", fields: [createdById], references: [id])
  themeOverrides Json?
  config         Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ownerId])
  @@index([prospectId])
  @@index([kind])
  @@index([ownerId, kind])
  @@index([createdById])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Internal team member. Created lazily on first allowlisted sign-in.
model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  /// Dynamic JWT `sub`; joins legacy `ownerId` values. Write-once (service layer).
  dynamicUserId      String?          @unique
  displayName        String?
  avatarUrl          String?
  schedulingUrl      String?
  role               Role             @default(MEMBER)
  deactivatedAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  shareLinks         ShareLink[]
  memberships        TeamMembership[]
  createdProspects   Prospect[]       @relation("ProspectCreatedBy")
  createdDemoConfigs DemoConfig[]     @relation("DemoConfigCreatedBy")
}

/// Per-prospect trackable demo link, minted by a user.
model ShareLink {
  id           String           @id @default(cuid())
  token        String           @unique // nanoid(21), url-safe
  demoConfigId String
  prospectId   String
  userId       String
  status       String           @default("active") // "active" | "revoked"
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id])
  sessions     VisitorSession[]
}

/// One visitor's session on a live demo. Geo/UA are derived server-side,
/// never trusted from the client payload.
model VisitorSession {
  id          String       @id // client-generated UUID - no @default; upserts must stay idempotent
  shareLinkId String?
  demoSlug    String
  anonId      String
  startedAt   DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())
  device      String?
  os          String?
  browser     String?
  country     String?
  region      String?
  city        String?
  ipHash      String?
  isInternal  Boolean      @default(false)
  enrichment  Json?
  shareLink   ShareLink?   @relation(fields: [shareLinkId], references: [id])
  events      TrackEvent[]

  @@index([shareLinkId])
  @@index([demoSlug, startedAt])
}

/// One tracked event in a session. "heartbeat"-named events advance the
/// session's lastSeenAt but are never persisted here.
model TrackEvent {
  id        String         @id // client-generated event UUID - doubles as the idempotency key
  sessionId String
  ts        DateTime
  type      String // "pageview" | "step" | "milestone"
  name      String
  path      String?
  props     Json?
  session   VisitorSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, ts])
}
