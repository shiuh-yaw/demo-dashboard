// Prisma schema for @dynamic-demos/db
//
// Phase 2 scaffold — no real models yet. Subsequent PRs (2-brands,
// 2-remittance, 2-others, 2-transactions) introduce the actual data model.
//
// Decisions referenced:
//   - D-013: Postgres = Prisma + Supabase. Two URLs (pooler runtime, direct migrations).
//   - D-015: packages/db consumed only by apps/dashboard. Apps fetch via dashboard API.
//
// Hard rules:
//   - DATABASE_URL must point at the Supabase pooler (port 6543) for runtime.
//   - DIRECT_URL must point at the direct connection (port 5432) for migrations.
//   - `prisma db push` is forbidden in production. Only `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Models added incrementally — one PR per migration.
//
// Landed:
//   PR 2-brands (this PR — Part A): Brand.
//
// Pending:
//   PR 2-remittance: RemittanceConfig (adds brandId FK).
//   PR 2-others: EarnConfig, VisaDirectConfig, WalletConfig, TradeConfig,
//                DepositConfig, ShopConfig, SandwichConfig, CheckoutConfig.
//   PR 2-transactions: Transaction, WebhookEvent.

/// First-class Brand record. Owns shared theme + logo metadata that demo
/// configs (remittance, earn, etc.) will reference via FK in subsequent PRs.
/// `id` is application-generated (cuid) so it stays stable across backfill
/// and matches the existing service-layer convention.
model Brand {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  description    String?
  primaryColor   String
  secondaryColor String?
  accentColor    String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerId])
}
