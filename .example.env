# ==============================================================================
# Demo Dashboard Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Dynamic Labs (Required)
# Get from: https://app.dynamic.xyz
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id

# ------------------------------------------------------------------------------
# Coinbase API (Required)
# Get from: https://www.coinbase.com/developer-platform
# ------------------------------------------------------------------------------
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# ------------------------------------------------------------------------------
# LI.FI API (Required)
# Get from: https://li.fi/
# ------------------------------------------------------------------------------
LIFI_API_KEY=your_lifi_api_key

# ------------------------------------------------------------------------------
# Redis Configuration
# Local: Use REDIS_URL for local Redis instance
# Production: Use Upstash Redis REST API
# ------------------------------------------------------------------------------
# Local development (defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Upstash Redis (for production/realtime features)
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ------------------------------------------------------------------------------
# QStash (Optional - for background job processing)
# Get from: https://console.upstash.com/qstash
# ------------------------------------------------------------------------------
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
# Base URL for QStash callbacks (your deployed URL in production)
APP_URL=http://localhost:3000

# Cron secret for Vercel cron job authentication
CRON_SECRET=your_cron_secret

# ------------------------------------------------------------------------------
# AI Features (Optional)
# ------------------------------------------------------------------------------
# Anthropic API key for AI theme extraction
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# ------------------------------------------------------------------------------
# BlindPay (Required for PIX/Bank withdrawals)
# Get from: https://app.blindpay.com
# Docs: https://www.blindpay.com/docs/getting-started/overview
# ------------------------------------------------------------------------------
# API URL (defaults to production)
BLINDPAY_API_URL=https://api.blindpay.com/v1

# Your BlindPay instance ID
# Create at: https://app.blindpay.com/instances
BLINDPAY_INSTANCE_ID=your_blindpay_instance_id

# Your BlindPay API key
# Create at: https://app.blindpay.com/instances/{instance_id}/api-keys
BLINDPAY_API_KEY=your_blindpay_api_key

# Environment: "sandbox" for testing, "production" for live
IRON_ENVIRONMENT=sandbox
IRON_API_KEY="your_iron_api_key"

# ------------------------------------------------------------------------------
# Postgres / Supabase (Phase 2)
# Two URLs (D-013):
#   DATABASE_URL  — pooler, port 6543, used at runtime by @dynamic-demos/db.
#   DIRECT_URL    — direct connection, port 5432, used by `prisma migrate`.
# Optional today; required once data is moved into Postgres.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres
