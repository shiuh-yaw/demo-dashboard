{
  "name": "dynamic-demos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:dashboard": "turbo run dev --filter=@dynamic-demos/dashboard",
    "dev:earn": "turbo run dev --filter=@dynamic-demos/earn",
    "dev:checkouts": "turbo run dev --filter=@dynamic-demos/checkouts",
    "dev:wallet": "turbo run dev --filter=@dynamic-demos/wallet",
    "dev:remittance": "turbo run dev --filter=@dynamic-demos/remittance",
    "dev:deposit": "turbo run dev --filter=@dynamic-demos/deposit",
    "dev:spark26": "turbo run dev --filter=@dynamic-demos/spark26",
    "dev:proceeds": "turbo run dev --filter=@dynamic-demos/proceeds",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "registry": "node scripts/generate-demo-registry.mjs",
    "registry:check": "node scripts/generate-demo-registry.mjs --check",
    "lint:agents-md": "node scripts/lint-agents-md.mjs",
    "test:skill": "pnpm --filter @dynamic-demos/dashboard exec vitest run --config ../../.claude/skills/create-demo-app/__tests__/vitest.skill.config.ts failure-modes.test.ts",
    "test:skill:success": "pnpm --filter @dynamic-demos/dashboard exec vitest run --config ../../.claude/skills/create-demo-app/__tests__/vitest.skill.config.ts success-path.test.ts"
  },
  "devDependencies": {
    "turbo": "2.8.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "ufo": "1.6.2",
      "axios": "1.13.6",
      "axios": "1.13.6"
    }
  }
}
