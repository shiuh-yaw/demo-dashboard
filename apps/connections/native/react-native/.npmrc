; npm reads project config from the cwd only - it does not walk up to the repo
; root - so this sample resolves through the public registry unless the approved
; Artifactory registry is declared here. The vendored upstream lockfile was
; generated outside Fireblocks and pinned registry.npmjs.org tarball URLs.
; Token comes from the environment; never commit a literal one.
registry=https://fbinfra555artifactory.jfrog.io/artifactory/api/npm/dynamic-npm
always-auth=true
//fbinfra555artifactory.jfrog.io/artifactory/api/npm/dynamic-npm/:_authToken=${JFROG_TOKEN}
