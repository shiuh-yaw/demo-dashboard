# ──────────────────────────────────────────────────────────
# Connect - Environment Variables
# Copy to .env.local and fill in your values. All sandbox by default (D-005).
# ──────────────────────────────────────────────────────────

# Dynamic environment ID (public client identifier, not a secret).
# Optional - falls back to NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID_DEFAULT via
# resolveCredentials(). Get one at https://app.dynamic.xyz/dashboard/developer/api
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Where to redirect after a successful connection when the caller supplies no
# `redirect_uri`. Optional - when unset, the same-origin /callback page is used,
# which renders the params we handed back. Set this to your real endpoint.
NEXT_PUBLIC_CONNECT_REDIRECT_BASE_URL=

# Strict allow-list of URL schemes accepted in `redirect_uri` (comma-separated,
# e.g. "https,fbconnectdemo"). Optional - unset means permissive mode: http(s)
# plus any hierarchical custom app scheme not on the dangerous block-list.
#
# SECURITY: `redirect_uri` is caller-supplied, so this is an open-redirect
# surface. Any deployment reachable by untrusted callers SHOULD set this, and
# SHOULD additionally allow-list the permitted http(s) hosts. See
# lib/redirect.ts and the "Security" section of AGENTS.md.
NEXT_PUBLIC_CONNECT_ALLOWED_REDIRECT_SCHEMES=

# Dashboard ingest base URL for GTM analytics. Optional - no-op when unset.
NEXT_PUBLIC_TRACK_URL=

# Base URL of the demo-dashboard app, used to fetch branding/theme configs.
# Optional - defaults to http://localhost:4000.
DASHBOARD_API_URL=http://localhost:4000
