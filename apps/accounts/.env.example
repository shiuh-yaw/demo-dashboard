# Dynamic environment id for this demo (public - not a secret).
#
# IMPORTANT: Business Accounts is an early-access feature gated by the
# `enable-business-accounts` flag on the environment. Point this at an
# environment where that flag is on, or every account call returns 403.
# The environment also needs at least one step-up-capable credential
# (email OTP, TOTP, or passkey) enabled - adding signers and members
# requires an elevated access token.
#
# Optional - falls back to NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID_DEFAULT via
# resolveCredentials() (D-003).
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Dashboard API base URL - where per-prospect theme configs are fetched from.
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:4000

# GTM ingest base URL (@dynamic-demos/analytics). Unset => <GtmTracker>,
# useTrack(), and <BookACallCta> are total no-ops.
NEXT_PUBLIC_TRACK_URL=

# Dynamic admin API token - SECRET, server-only, never NEXT_PUBLIC_.
# Used by app/api/hidden-accounts to read and write the signed-in user's
# Dynamic metadata. Create one in the Dynamic dashboard for the same project
# as NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID.
# https://www.dynamic.xyz/docs/developer-dashboard/api-tokens
DYNAMIC_API_KEY=
