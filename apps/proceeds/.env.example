# ──────────────────────────────────────────────────────────
# Proceeds Developer Payouts — Environment Variables
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# Dynamic Labs (required)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=      # Dynamic environment ID — get from app.dynamic.xyz

# Alchemy (required)
ALCHEMY_API_KEY=                         # Alchemy API key — used server-side for on-chain tx history

# Fireblocks (optional) — custodial off-ramp provider
FIREBLOCKS_API_KEY=                      # Fireblocks API key
FIREBLOCKS_API_SECRET=                   # Fireblocks API secret (PEM private key)

# IRON Finance / MoonPay (optional) — off-ramp USDC → USD to bank account
IRON_API_KEY=                            # IRON Finance API key
IRON_ENVIRONMENT=sandbox                 # IRON environment: sandbox | production (default: sandbox)
IRON_DEMO_CUSTOMER_ID=                   # IRON demo customer ID
IRON_DEMO_BANK_IBAN=                     # IRON demo bank IBAN
