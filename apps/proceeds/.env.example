# ──────────────────────────────────────────────────────────
# Proceeds Developer Payouts — Environment Variables
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# Dynamic Labs (required)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=      # Dynamic environment ID — get from app.dynamic.xyz

# Alchemy (required)
ALCHEMY_API_KEY=                         # Alchemy API key — used server-side for on-chain tx history

# Fireblocks (optional) — custodial off-ramp provider
FIREBLOCKS_API_KEY=                      # Fireblocks API key
FIREBLOCKS_API_SECRET=                   # Fireblocks API secret (PEM private key)

# IRON Finance / MoonPay (optional) — off-ramp USDC → USD to bank account
# When IRON_API_KEY is unset the iron-dependent routes log a warning at request
# time and degrade; the build itself does not require any IRON variable.
IRON_API_KEY=                            # IRON Finance API key
IRON_ENVIRONMENT=sandbox                 # IRON environment: sandbox | production (default: sandbox)
IRON_DEMO_CUSTOMER_ID=                   # IRON demo customer ID
IRON_DEMO_BANK_IBAN=                     # IRON demo bank IBAN

# Build-time escape hatch (optional). Set to "true" to skip env validation
# during `next build` in environments without provider credentials (fresh-clone
# smoke tests, integration test harnesses). Vercel preview deploys carry the
# real values and should NEVER set this. Mirrors apps/spark26 pattern.
SKIP_ENV_VALIDATION=                     # "true" to skip validation at build

# GTM analytics tracker (optional) - dashboard base URL that
# @dynamic-demos/analytics posts session/step/milestone events to. Unset ->
# <GtmTracker> and useTrack() are total no-ops.
# NEXT_PUBLIC_TRACK_URL=http://localhost:4000
