# ──────────────────────────────────────────────────────────
# Visa Direct Host Portal — Environment Variables
# Copy to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# Dynamic Labs
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=       # Required — Dynamic environment ID (matches every other demo in the monorepo)
DYNAMIC_API_KEY=                          # Optional — enables user metadata persistence (cross-device preferences)

# Fireblocks — required config (validated in lib/env.ts)
# The payout route always needs these three to build a valid orders payload,
# even when FIREBLOCKS_API_KEY/SECRET are absent (mock mode).
FIREBLOCKS_VAULT_ACCOUNT_ID=              # Required — MTLco connected sub-account ID
FIREBLOCKS_PROVIDER_ID=FIREBLOCKS_TESTNET # Required — "FIREBLOCKS_TESTNET" (sandbox) or "FIREBLOCKS" (mainnet)
FIREBLOCKS_ASSET_ID=USDC_ETH_TEST5_0GER   # Required — e.g. USDC_ETH_TEST5_0GER (Sepolia) or USDC_ETH (mainnet)

# Fireblocks — credentials (optional; mock responses used when absent)
FIREBLOCKS_API_KEY=                       # API user key from Fireblocks console
FIREBLOCKS_API_SECRET=                    # RSA private key (base64 PEM or raw PEM with \n)

# Visa Direct (stubbed in current phases)
VISA_DIRECT_API_KEY=                      # Visa Direct API key
VISA_DIRECT_BASE_URL=                     # Visa Direct base URL

# Dashboard API (for branding/theme configs)
DASHBOARD_API_URL=http://localhost:4000   # Optional — base URL of the demo-dashboard app (defaults to localhost:4000)
