# Dynamic (client SDK + server JWT + admin API for deposit webhook)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_KEY=

# Default network before first visit (header switcher persists in localStorage)
# base | base-sepolia
# NEXT_PUBLIC_NETWORK=base

# Fireblocks (required — deposit uses the live API only)
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=
# FIREBLOCKS_API_BASE_URL=https://sandbox-api.fireblocks.io/v1


# Webhook verification — prefer JWKS (Fireblocks-Webhook-Signature header)
# https://developers.fireblocks.com/reference/validating-webhooks#validating-webhooks-jwks
# Optional; defaults from FIREBLOCKS_API_BASE_URL (sandbox → sandbox-keys, else US prod keys).
# EU: FIREBLOCKS_WEBHOOK_JWKS_URL=https://eu-keys.fireblocks.io/.well-known/jwks.json
# FIREBLOCKS_WEBHOOK_JWKS_URL=

# Legacy header (Fireblocks-Signature / x-fireblocks-signature) + PEM public key
# FIREBLOCKS_WEBHOOK_PUBLIC_KEY=

# GTM analytics tracker (optional) - dashboard base URL that
# @dynamic-demos/analytics posts session/step/milestone events to. Unset ->
# <GtmTracker> and useTrack() are total no-ops.
# NEXT_PUBLIC_TRACK_URL=http://localhost:4000
