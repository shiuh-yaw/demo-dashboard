# Dynamic Environment ID - Get from https://app.dynamic.xyz/dashboard/developer/api
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_environment_id_here

# Dashboard API URL (optional) - defaults to http://localhost:4000
# Used for fetching wallet configs on /w/[id] routes
# NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:4000

# ─── Delegated access (MPC) ───
# All six are optional; with any of them missing the delegation routes 503
# and the rest of the app is unaffected. This app receives the webhook, holds
# the share and signs - the dashboard is not involved.
# Point the Dynamic webhook at https://<this-app>/api/webhooks/dynamic.

# Signing secret for that webhook - Dynamic Dashboard → Webhooks.
# Unset -> the route fails closed with 401 rather than trusting the delivery.
# DYNAMIC_WEBHOOK_SECRET=your_webhook_secret_here

# Dynamic API token (dyn_...) used to build the delegated signing client.
# DYNAMIC_API_TOKEN=

# RSA private key (PKCS#8 PEM, raw or base64) whose PUBLIC half is registered
# with Dynamic - it decrypts the wallet.delegation.created envelope. Register
# the matching key or the payload's `kid` will not resolve and decryption
# fails.  openssl genpkey -algorithm RSA -pkcs8 -pkeyopt rsa_keygen_bits:3072
# DELEGATION_RSA_PRIVATE_KEY=

# 32-byte AES-256-GCM key sealing delegated materials at rest. Distinct from
# the RSA key, and generated fresh per environment - never copied between
# them.  openssl rand -base64 32
# DELEGATION_ENC_KEY=

# Upstash Redis - where the sealed share and wallet API key live (rule 2: apps
# use Redis, never Postgres; never Dynamic user metadata, which the client can
# read).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── External JWT Auth (optional) ───
# Generate these values by running:  npx tsx scripts/generate-keypair.ts
# See docs/external-jwt-auth.md for the full setup guide.
#
# JWT_PROVIDER_KID=demo-key-xxxxx
# JWT_PROVIDER_ISSUER=https://demo-jwt-provider.example.com
# JWT_PROVIDER_PUBLIC_KEY='{"kty":"RSA","n":"...","e":"..."}'
# JWT_PROVIDER_PRIVATE_KEY='{"kty":"RSA","n":"...","e":"...","d":"..."}'

# Alchemy API key (server-only) - powers Base Sepolia token balances
# (Dynamic balances API does not cover Base Sepolia). Optional.
ALCHEMY_API_KEY=

# GTM analytics tracker (optional) - dashboard base URL that
# @dynamic-demos/analytics posts session/step/milestone events to. Unset ->
# <GtmTracker> and useTrack() are total no-ops.
# NEXT_PUBLIC_TRACK_URL=http://localhost:4000
