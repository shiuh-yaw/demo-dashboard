# Dynamic Environment ID - Get from https://app.dynamic.xyz/dashboard/developer/api
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_environment_id_here

# Dashboard API URL (optional) - defaults to http://localhost:4000
# Used for fetching wallet configs on /w/[id] routes
# NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:4000

# Dynamic Webhook Secret (optional) - Get from Dynamic Dashboard → Webhooks
# Used to verify webhook signatures. If not set, signature verification is skipped.
# DYNAMIC_WEBHOOK_SECRET=your_webhook_secret_here

# ─── External JWT Auth (optional) ───
# Generate these values by running:  npx tsx scripts/generate-keypair.ts
# See docs/external-jwt-auth.md for the full setup guide.
#
# JWT_PROVIDER_KID=demo-key-xxxxx
# JWT_PROVIDER_ISSUER=https://demo-jwt-provider.example.com
# JWT_PROVIDER_PUBLIC_KEY='{"kty":"RSA","n":"...","e":"..."}'
# JWT_PROVIDER_PRIVATE_KEY='{"kty":"RSA","n":"...","e":"...","d":"..."}'

# Alchemy API key (server-only) - powers Base Sepolia token balances
# (Dynamic balances API does not cover Base Sepolia). Optional.
ALCHEMY_API_KEY=
