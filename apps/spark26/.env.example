# Dynamic Labs
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your-dynamic-env-id
DYNAMIC_API_KEY=dyn_YourServerSideKeyHere

# Cvent
CVENT_CLIENT_ID=your-cvent-client-id
CVENT_CLIENT_SECRET=your-cvent-client-secret
CVENT_EVENT_ID=your-cvent-event-id
CVENT_BASE_URL=https://api-platform.cvent.com

# Settlement
# Must be a valid 0x-prefixed 40-char EVM address (validated at boot).
SPARK26_DESTINATION_ADDRESS=0x0000000000000000000000000000000000000000

# Redis
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_URL=redis://localhost:6379

# QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key

# Vercel cron
CRON_SECRET=generate-a-strong-random-string

# Admin / debug
SPARK26_ADMIN_SECRET=generate-a-strong-random-string

# App env
NEXT_PUBLIC_APP_ENV=preview
