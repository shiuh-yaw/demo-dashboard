{
  "name": "@dynamic-demos/spark26",
  "version": "0.1.0",
  "description": "Spark26 conference payment microsite — crypto payment for Cvent-registered attendees",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n redis,next -c magenta,cyan \"pnpm dev:redis\" \"pnpm dev:next\"",
    "dev:next": "next dev -p 4010",
    "dev:redis": "redis-server --port 6379 --save \"\" --appendonly no --loglevel warning",
    "build": "next build",
    "start": "next start -p 4010",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cvent/sdk": "1.1.6",
    "@dynamic-demos/theme": "workspace:*",
    "@dynamic-demos/types": "workspace:*",
    "@dynamic-demos/ui": "workspace:*",
    "@dynamic-demos/utils": "workspace:*",
    "@dynamic-labs-sdk/bitcoin": "0.25.0",
    "@dynamic-labs-sdk/client": "0.25.0",
    "@dynamic-labs-sdk/evm": "0.25.0",
    "@dynamic-labs-sdk/solana": "0.25.0",
    "@dynamic-labs-sdk/wallet-connect": "0.25.0",
    "@t3-oss/env-nextjs": "0.13.8",
    "@tanstack/react-query": "5.81.2",
    "@upstash/qstash": "2.7.23",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.3",
    "ioredis": "5.4.1",
    "lucide-react": "0.541.0",
    "next": "15.5.18",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "viem": "2.42.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@dynamic-demos/tsconfig": "workspace:*",
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.27",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "2.1.9",
    "concurrently": "9.1.2",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.18",
    "jsdom": "24.1.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "undici": "6.21.1",
    "vitest": "2.1.9"
  }
}
