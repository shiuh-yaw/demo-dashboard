# ==============================================================================
# Payment Widget Environment Variables
# Copy this file to .env.local and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Dynamic Labs (Required)
# Get from: https://app.dynamic.xyz
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id

# ------------------------------------------------------------------------------
# Dashboard API (Required)
# URL of the demo-dashboard API that handles checkouts, transactions, and swaps
# In development, this is typically http://localhost:4000
# In production, use your deployed dashboard URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DASHBOARD_API_URL=http://localhost:4000
