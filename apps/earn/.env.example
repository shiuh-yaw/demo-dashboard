# Dynamic SDK - per-app sandbox environment id (D-004). Required.
# Generate at https://app.dynamic.xyz under your demo-app sandbox env.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Dashboard API URL - base URL for earn config fetches.
# Defaults to http://localhost:4000 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Alchemy API key - server-only, used by /api/balance to read the wallet's
# Dynamic USDC balance on Base Sepolia (Dynamic's balances API doesn't cover
# Base Sepolia). Same key pattern as apps/proceeds / apps/remittance /
# apps/trade. Get one at https://dashboard.alchemy.com.
ALCHEMY_API_KEY=

# GTM analytics tracker (optional) - dashboard base URL that
# @dynamic-demos/analytics posts session/step/milestone events to. Unset ->
# <GtmTracker> and useTrack() are total no-ops.
# NEXT_PUBLIC_TRACK_URL=http://localhost:4000
