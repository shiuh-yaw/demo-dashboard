# ==============================================================================
# Earn Demo Dashboard Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Dynamic Labs (Required)
# Get from: https://app.dynamic.xyz
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id

# ------------------------------------------------------------------------------
# Backend API (Optional)
# Points to demo-dashboard for any backend services
# Note: BlindPay integration uses mock responses (no real API calls)
# For real BlindPay integration, see examples/nextjs-global-payments-blindpay
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
