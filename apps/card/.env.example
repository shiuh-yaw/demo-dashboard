# Dynamic Environment ID - Get from https://app.dynamic.xyz/dashboard/developer/api
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_environment_id_here

# Workspace-default Dynamic environment ID, used when the per-app id above is unset.
# NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID_DEFAULT=

# NOTE: no DYNAMIC_API_KEY here. The card app never reads it - card issuance
# goes through the dashboard's /api/rain/* (which holds RAIN_API_KEY) and the
# card is stored client-side in Dynamic user metadata (no admin token). The
# browser Dynamic client only needs the environment id above.

# Dashboard GTM analytics ingest base URL (@dynamic-demos/analytics) - optional.
# Unset -> <GtmTracker>/useTrack()/<BookACallCta> are total no-ops; the app
# builds and runs unchanged. Local dev: the dashboard runs on port 4000.
# NEXT_PUBLIC_TRACK_URL=http://localhost:4000

# "production" flips sandbox off (D-005). Leave unset for sandbox (default).
# NEXT_PUBLIC_APP_ENV=production

# Dashboard origin - apps/card reaches Rain only through the dashboard /api/rain/* routes.
# Local dev: the dashboard runs on port 4000.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:4000

# apps/card never holds RAIN_API_KEY (hard rule 3) - Rain is reached only
# through the dashboard's /api/rain/* routes, which hold that secret.
