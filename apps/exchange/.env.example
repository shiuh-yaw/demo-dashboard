# Dynamic environment id - https://app.dynamic.xyz/dashboard/developer/api
# Optional in STAGED mode (the default when unset): the five beats run as a
# fully local simulation of the 2-of-2 TSS-MPC flow, safe on stage wifi.
# Set a SANDBOX environment id to run LIVE against Ethereum Sepolia.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Force the mode regardless of the environment id: "staged" | "live".
# Unset -> live when an environment id is present, staged otherwise.
# NEXT_PUBLIC_EXCHANGE_MODE=staged

# Sandbox-by-default (D-005). "production" flips the SDK credentials to
# production; never set it for this demo.
# NEXT_PUBLIC_APP_ENV=

# Dashboard origin for `?theme=<configId>` brand configs (D-008). Optional -
# unset renders Exchange's default amber palette.
# DASHBOARD_URL=http://localhost:4000

# Sepolia RPC for live-mode balance reads. Optional - a public RPC is used
# when unset.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=

# GTM analytics tracker (optional) - dashboard base URL that
# @dynamic-demos/analytics posts session/step/milestone events to. Unset ->
# <GtmTracker> and useTrack() are total no-ops.
# NEXT_PUBLIC_TRACK_URL=http://localhost:4000

# Live-mode faucet (optional). Server-only: the key is never sent to the browser.
# Generate with `pnpm --filter @dynamic-demos/exchange faucet:keygen`, then fund
# the printed address with Sepolia USDC (faucet.circle.com) and a little Sepolia
# ETH for gas. Unset = "Add funds" shows the deposit address instead.
# FAUCET_PRIVATE_KEY=0x...
# FAUCET_MAX_USDC=50
# FAUCET_DAILY_PER_ADDRESS=200
# SEPOLIA_RPC_URL=
