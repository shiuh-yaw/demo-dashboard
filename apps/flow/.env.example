# Dynamic SDK — per-app sandbox environment id (D-004: distinct from
# apps/dashboard's operator env). Optional if the workspace default
# (NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID_DEFAULT) is set; otherwise required.
# Generate at https://app.dynamic.xyz under your demo-app sandbox env.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Flow widget (`<PaymentWidget>` from @dynamic-demos/checkouts-widget).
# Optional — a sandbox Checkout id is baked in as the default so the
# /checkout slot works out-of-the-box. Override here if you create your
# own Checkout via POST /environments/{envId}/checkouts.
NEXT_PUBLIC_DYNAMIC_CHECKOUT_ID=

# Server-only Dynamic API token for THIS app's env (not the dashboard operator
# env), created under the env id above. ONE token covers everything the flow
# app does server-side — give it both scopes (same var name as every other
# demo app):
#   - flow.write       → POST /api/checkouts creates Flows
#   - user read+write  → /kyc-deposit persists `is_kyc_completed` to user metadata
DYNAMIC_API_KEY=

# Dashboard API URL — used by the /kyc-deposit scenario to proxy
# SumSub operations via the dashboard (D-003: provider secrets stay in
# dashboard). Server-only. In development this is typically
# http://localhost:4000.
DASHBOARD_API_URL=http://localhost:4000

# Alchemy API key - server-only, used by /api/kyc-deposit/balances to read
# the connected wallet's USDC balance on Base Sepolia (Dynamic's balances
# API doesn't cover Base Sepolia). Same key pattern as apps/proceeds /
# apps/remittance / apps/trade. Get one at https://dashboard.alchemy.com.
ALCHEMY_API_KEY=

# Note: /kyc-deposit deposits are a self-send to the user's own connected
# wallet (no fixed merchant deposit address). The merchant Iron off-ramp is
# simulated on the dashboard backend.
