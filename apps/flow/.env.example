# Dynamic SDK — per-app sandbox environment id. Optional if the workspace
# default (NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID_DEFAULT) is set; otherwise
# required. Generate at https://app.dynamic.xyz under your sandbox env.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Flow widget (`<PaymentWidget>` from @dynamic-demos/checkouts-widget).
# Optional — a sandbox Checkout id is baked in as the default so the
# /checkout slot works out-of-the-box. Override here if you create your
# own Checkout via POST /environments/{envId}/checkouts.
NEXT_PUBLIC_DYNAMIC_CHECKOUT_ID=

# Server-only admin API token used by POST /api/checkouts to mint a
# per-withdraw Flow Checkout (the withdraw destination changes per
# transaction, so each withdraw needs its own Checkout). Required for
# the /withdraw scenario; optional otherwise. Generate at
# https://app.dynamic.xyz/dashboard/developer/api.
DYNAMIC_API_TOKEN=
