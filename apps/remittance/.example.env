# ==============================================================================
# Remittance Demo Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# Dynamic Labs (Required)
# Get from: https://app.dynamic.xyz
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your_dynamic_environment_id

# ------------------------------------------------------------------------------
# Backend API (Optional)
# Points to demo-dashboard for remittance configs (theme/branding)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Alchemy (Required for transaction history)
# Get from: https://dashboard.alchemy.com
# ------------------------------------------------------------------------------
ALCHEMY_API_KEY=your_alchemy_api_key

# ------------------------------------------------------------------------------
# Fireblocks (Optional - for custody, fund/release)
# Get from: https://console.fireblocks.com
# ------------------------------------------------------------------------------
# FIREBLOCKS_API_KEY=your_fireblocks_api_key
# FIREBLOCKS_API_SECRET=your_fireblocks_api_secret
# FIREBLOCKS_API_BASE_URL=https://sandbox-api.fireblocks.io
# FIREBLOCKS_OMNIBUS_VAULT_ID=your_vault_id
# FIREBLOCKS_DEFAULT_ASSET_ID=your_asset_id

# ------------------------------------------------------------------------------
# Dynamic API (Optional - for server-side admin operations)
# ------------------------------------------------------------------------------
# DYNAMIC_API_KEY=your_dynamic_api_key
