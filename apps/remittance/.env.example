# Dynamic Labs
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# Dynamic Server API (admin operations)
DYNAMIC_API_KEY=

# Fireblocks (optional — uses mock client if not set)
FIREBLOCKS_API_KEY=
# The full PEM private key content (not a file path).
# For Vercel: paste the multi-line PEM directly into the environment variable value field.
FIREBLOCKS_API_SECRET=
# Use https://api.fireblocks.io/v1 for US mainnet/testnet workspaces
# Use https://sandbox-api.fireblocks.io/v1 for sandbox-only workspaces
FIREBLOCKS_API_BASE_URL=https://api.fireblocks.io/v1

# Fireblocks Omnibus Vault (create via /admin/vaults, then set the vault ID here)
FIREBLOCKS_OMNIBUS_VAULT_ID=
# Default asset ID for omnibus (check /admin/assets for supported IDs in your workspace)
FIREBLOCKS_DEFAULT_ASSET_ID=
