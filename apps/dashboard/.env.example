# ──────────────────────────────────────────────────────────
# Dynamic Demos Dashboard — Environment Variables
# Copy to .env.local and fill in your values.
# Sandbox by default (D-005). Production opt-in requires explicit env
# vars + a `[prod-creds]` PR title at change time.
# ──────────────────────────────────────────────────────────

# Dynamic Labs (required)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=     # Dynamic environment ID — get from app.dynamic.xyz

# Coinbase Onramp (required) — sandbox by default per D-005
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_ENVIRONMENT=sandbox       # sandbox | production (default: sandbox)

# LI.FI (required)
LIFI_API_KEY=

# Anthropic (optional) — used by the AI theme extractor
ANTHROPIC_API_KEY=

# Redis (local dev defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Upstash Redis (production — overrides REDIS_URL when both are set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (optional, for background jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Vercel Cron secret (optional)
CRON_SECRET=

# BlindPay (optional, sandbox by default)
BLINDPAY_API_URL=https://api.blindpay.com/v1
BLINDPAY_INSTANCE_ID=
BLINDPAY_API_KEY=
BLINDPAY_WEBHOOK_SECRET=

# Rain issuing API (stablecoin debit cards) - sandbox by default.
# Production requires a [prod-creds] PR. Never commit a real key.
RAIN_API_KEY=your-rain-api-key
RAIN_API_BASE_URL=https://api-dev.raincards.xyz

# Iron Finance (optional, sandbox by default)
IRON_ENVIRONMENT=sandbox
IRON_API_KEY=
# Fixed merchant Iron customer that receives ALL /kyc-deposit settlements
# (one merchant, like paying a business). Settles in USD via ACH (USDC → USD,
# ~1:1). In SANDBOX the merchant-offramp route auto-onboards this customer to
# `Active` (approves KYC + signings + registers/approves the USD ACH account),
# so you only need to create the customer in the Iron sandbox dashboard and
# supply its id. The routing/account numbers default to public ACH sandbox test
# fixtures; override for a specific account.
# Drives the sandbox offramp simulation (see packages/iron/docs/iron-sandbox-testing.md).
IRON_MERCHANT_CUSTOMER_ID=
IRON_MERCHANT_BANK_ROUTING_NUMBER=021000021
IRON_MERCHANT_BANK_ACCOUNT_NUMBER=000123456789
IRON_MERCHANT_OFFRAMP_CURRENCY=USD

# SumSub KYC (optional, sandbox by default) — powers apps/flow /kyc-deposit.
# App token + secret from Cockpit → Dev space → App tokens (sandbox tokens
# start with `sbx:`). SUMSUB_LEVEL_NAME MUST match a level that exists in the
# connected account (Cockpit → Verification levels), otherwise applicant
# creation fails with `Level '…' not found` (404). The default matches the
# demo account's `id-only` level.
SUMSUB_ENVIRONMENT=sandbox
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=id-only

# Postgres (Supabase)
DATABASE_URL=                            # Pooler URL (port 6543) — used at runtime
DIRECT_URL=                              # Direct URL (port 5432) — used by `prisma migrate`

# Phase 7 — Magic-send primitive
# Sandbox vault EOA holding test USDC. SANDBOX ONLY per D-005.
# Production deployments swap in a Fireblocks-backed vault adapter
# in a follow-up PR; do NOT put a mainnet private key here.
MAGIC_SEND_VAULT_PRIVATE_KEY=            # 0x-prefixed hex private key (sandbox)
MAGIC_SEND_VAULT_CHAIN_ID=84532          # Base Sepolia by default
MAGIC_SEND_VAULT_RPC_URL=https://sepolia.base.org

# Dynamic webhook signing secret — per-webhook value from Dynamic dashboard.
# When unset, /api/webhooks/dynamic fails closed with 401.
DYNAMIC_WEBHOOK_SECRET=

# Dynamic admin API bearer token (dyn_...). Reserved for admin API access
# (e.g. listing environment users). Sandbox token by default (D-005); never
# commit a real value. No runtime request path reads this.
DYNAMIC_API_TOKEN=

# Internal API gating secret. Required for /api/magic-send/intents/[id]/execute.
# External callers cannot trigger userop dispatch — only the dashboard's own
# webhook receiver may.
INTERNAL_API_SECRET=

# App URL (production deploys; used by QStash callbacks)
APP_URL=

# Vercel Blob store token (auto-injected on Vercel once a Blob store is
# connected to the project; pull locally via `vercel env pull`). Optional:
# without it, normalized brand logos are inlined as data URIs instead.
BLOB_READ_WRITE_TOKEN=

# CORS allowlist for the public tracker-facing endpoints (the /s/[token]
# context call, Phase GTM-06's /api/track): comma-separated demo origins.
# https dynamic.dev + subdomains are always allowed (builtin); list any
# other origin here. Empty allows only the builtins - the endpoints still
# respond, just without CORS headers. Local dev demos need their localhost
# origin added, e.g. append ",http://localhost:4011" for the card app.
TRACK_CORS_ORIGINS=https://wallet.dynamic.dev

# Pepper for hashing visitor IPs before persisting them (Phase GTM-06,
# POST /api/track). Raw IPs are never stored - only sha256(ip + salt).
# Set a real random value in deployed environments. Required when
# NEXT_PUBLIC_APP_ENV=production - the app throws at startup if unset.
IP_HASH_SALT=

# Optional per-kind demo launch-URL overrides (JSON). Catalog URLs are canonical;
# use this for local dev servers or kinds without a public domain.
NEXT_PUBLIC_DEMO_URL_OVERRIDES={"checkout":"http://localhost:3000","visa-direct":"http://localhost:4007","card":"http://localhost:4011"}

# Phase GTM-10 company enrichment (src/lib/enrichment/) resolves a viewer's
# business email DOMAIN to a company profile via Claude - it reuses
# ANTHROPIC_API_KEY (above); unset -> noop provider, dashboard fully functional.

# Slack #leads notifier (optional; unset = notifier no-ops). Dashboard-only secret.
SLACK_BOT_TOKEN=
SLACK_LEADS_CHANNEL=
