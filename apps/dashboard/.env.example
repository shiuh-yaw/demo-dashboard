# ──────────────────────────────────────────────────────────
# Dynamic Demos Dashboard — Environment Variables
# Copy to .env.local and fill in your values.
# Sandbox by default (D-005). Production opt-in requires explicit env
# vars + a `[prod-creds]` PR title at change time.
# ──────────────────────────────────────────────────────────

# Dynamic Labs (required)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=     # Dynamic environment ID — get from app.dynamic.xyz

# Coinbase Onramp (required) — sandbox by default per D-005
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_ENVIRONMENT=sandbox       # sandbox | production (default: sandbox)

# LI.FI (required)
LIFI_API_KEY=

# Anthropic (optional) — used by the AI theme extractor
ANTHROPIC_API_KEY=

# Redis (local dev defaults to redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Upstash Redis (production — overrides REDIS_URL when both are set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash (optional, for background jobs)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Vercel Cron secret (optional)
CRON_SECRET=

# BlindPay (optional, sandbox by default)
BLINDPAY_API_URL=https://api.blindpay.com/v1
BLINDPAY_INSTANCE_ID=
BLINDPAY_API_KEY=
BLINDPAY_WEBHOOK_SECRET=

# Iron Finance (optional, sandbox by default)
IRON_ENVIRONMENT=sandbox
IRON_API_KEY=

# Postgres (Supabase)
DATABASE_URL=                            # Pooler URL (port 6543) — used at runtime
DIRECT_URL=                              # Direct URL (port 5432) — used by `prisma migrate`

# Postgres cutover flags (D-014). Default false until each cutover lands.
USE_POSTGRES_BRANDS=false
USE_POSTGRES_TRANSACTIONS=false
USE_POSTGRES_DEMO_CONFIGS=false

# Phase 7 — Magic-send primitive
# Sandbox vault EOA holding test USDC. SANDBOX ONLY per D-005.
# Production deployments swap in a Fireblocks-backed vault adapter
# in a follow-up PR; do NOT put a mainnet private key here.
MAGIC_SEND_VAULT_PRIVATE_KEY=            # 0x-prefixed hex private key (sandbox)
MAGIC_SEND_VAULT_CHAIN_ID=84532          # Base Sepolia by default
MAGIC_SEND_VAULT_RPC_URL=https://sepolia.base.org

# Dynamic webhook signing secret — per-webhook value from Dynamic dashboard.
# When unset, /api/webhooks/dynamic fails closed with 401.
DYNAMIC_WEBHOOK_SECRET=

# Internal API gating secret. Required for /api/magic-send/intents/[id]/execute.
# External callers cannot trigger userop dispatch — only the dashboard's own
# webhook receiver may.
INTERNAL_API_SECRET=

# App URL (production deploys; used by QStash callbacks)
APP_URL=
