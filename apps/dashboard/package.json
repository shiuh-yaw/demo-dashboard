    "@dynamic-demos/coinbase-onramp": "workspace:*",
    "@dynamic-demos/db": "workspace:*",
    "@dynamic-demos/dynamic": "workspace:*",
    "@dynamic-demos/iron": "workspace:*",
    "@dynamic-demos/sumsub": "workspace:*",
    "@dynamic-demos/lifi": "workspace:*",
    "@dynamic-demos/theme": "workspace:*",
    "@dynamic-demos/transactions": "workspace:*",
    "@dynamic-demos/types": "workspace:*",
    "@dynamic-demos/ui": "workspace:*",
    "@dynamic-demos/utils": "workspace:*",
    "@dynamic-labs-sdk/client": "catalog:",
    "@paralleldrive/cuid2": "2.2.2",
    "@t3-oss/env-nextjs": "0.13.8",
    "@upstash/qstash": "2.8.4",
    "@upstash/redis": "1.34.8",
    "clsx": "catalog:",
    "ioredis": "5.6.1",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.511.0",
    "next": "catalog:",
    "next-themes": "0.4.6",
    "pino-pretty": "13.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "3.3.0",
    "tw-animate-css": "catalog:",
    "viem": "2.37.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@dynamic-demos/tsconfig": "workspace:*",
    "@eslint/eslintrc": "catalog:",
    "@tailwindcss/postcss": "4.1.17",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.25",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "eslint": "catalog:",
