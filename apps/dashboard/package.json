{
  "name": "@dynamic-demos/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm --filter @dynamic-demos/db prisma:migrate:deploy; fi && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backfill:brands": "tsx --env-file=.env.local scripts/backfill-brands/cli.ts",
    "backfill:demo-configs": "tsx --env-file=.env.local scripts/backfill-demo-configs/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.71.2",
